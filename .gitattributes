# Set default behavior, that is, text files with LF line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - do not touch line endings
*.pkl binary
*.bin binary
*.joblib binary
*.cbm binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.db binary
*.sqlite binary
